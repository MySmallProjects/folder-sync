<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FolderSyncEr.Client.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="780"
        x:Class="FolderSyncEr.Client.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FolderSyncEr — Cross-Device File Sync"
        Width="1020" Height="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Main Application Layout -->
        <DockPanel Background="#111827">
            <!-- Top Status Bar & App Header -->
            <Border DockPanel.Dock="Top" Background="#1F2937" BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="20,14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Title and Status -->
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Connection status indicator (Red = Server not found, Amber = Server online / not signed in, Green = Signed in) -->
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding ConnectionStatusBrush}"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding ConnectionStatusToolTip}"/>
                            <TextBlock Text="FolderSyncEr" FontSize="20" FontWeight="Bold" Foreground="#60A5FA"/>
                            <!-- Sync state badge -->
                            <Border CornerRadius="12" Padding="8,2" Background="#374151" Margin="2,0,0,0">
                                <TextBlock Text="{Binding SyncStatusSummary}" FontSize="12" FontWeight="Medium" Foreground="#D1D5DB"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding LastSyncToolTip}">
                                <TextBlock Text="Last Sync:" FontSize="11" Foreground="#9CA3AF"/>
                                <TextBlock Text="{Binding LastSyncText}" FontSize="11" FontWeight="SemiBold" Foreground="#E5E7EB"/>
                            </StackPanel>

                            <!-- Backoff retry / Network status countdown indicator -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding ShowRetryIndicator}"
                                        ToolTip.Tip="{Binding RetryToolTip}">
                                <TextBlock Text="•" FontSize="11" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding RetryStatusText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding RetryStatusBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- In-flight progress -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0"
                                IsVisible="{Binding IsSynchronizing}">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <TextBlock Text="{Binding ProgressItem}" FontSize="11" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat={}{0:0}%}" FontSize="11" Foreground="#60A5FA" FontWeight="Bold"/>
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" Height="5"
                                     Foreground="#3B82F6" Background="#374151"/>
                    </StackPanel>

                    <!-- Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="Sync Now"
                                Command="{Binding SyncNowCommand}"
                                IsEnabled="{Binding !IsSynchronizing}"
                                Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                                Padding="14,7" CornerRadius="6"/>

                        <Button Content="{Binding PauseResumeButtonText}"
                                Command="{Binding TogglePauseResumeCommand}"
                                Background="#374151" Foreground="#E5E7EB" FontWeight="Medium"
                                Padding="12,7" CornerRadius="6"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Elevation / Sudo Warning Banner -->
            <Border DockPanel.Dock="Top" Background="#451A03" BorderBrush="#B45309" BorderThickness="0,0,0,1" Padding="16,8"
                    IsVisible="{Binding ShowElevationWarning}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ElevationWarningText}" Foreground="#FDE047" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissElevationWarningCommand}"
                            Background="Transparent" Foreground="#FDE047" FontSize="11" Padding="8,4"/>
                </Grid>
            </Border>

            <!-- Bottom Navigation Tabs -->
            <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="16">
                <!-- TAB 1: FILES LIST -->
                <TabItem Header="Files">
                    <Grid RowDefinitions="Auto,*" Margin="0,12,0,0" DataContext="{Binding FileList}">
                        <!-- File list toolbar -->
                        <Border Grid.Row="0" Background="#1F2937" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#374151" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <!-- Search filter -->
                                <TextBox Grid.Column="0" Text="{Binding SearchQuery, Mode=TwoWay}"
                                         Watermark="Search files by path or name..." Margin="0,0,12,0"/>

                                <!-- Status dropdown -->
                                <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}"
                                          SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                          Width="150" Margin="0,0,12,0"/>

                                <!-- Refresh button -->
                                <Button Grid.Column="2" Content="Refresh"
                                        Command="{Binding RefreshCommand}"
                                        Background="#374151" Foreground="#F3F4F6"
                                        Padding="14,6" Margin="0,0,12,0"/>

                                <TextBlock Grid.Column="3" Text="{Binding SummaryText}"
                                           Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- File Items List -->
                        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" BorderBrush="#374151" BorderThickness="1">
                            <ListBox ItemsSource="{Binding Files}" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FileItemViewModel">
                                        <Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="10,8">
                                            <Grid ColumnDefinitions="3*,2*,2*,120">
                                                <!-- File name & path -->
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" Foreground="#F9FAFB"/>
                                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Local Version info -->
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="LOCAL" FontSize="10" Foreground="#6B7280" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding LocalSizeFormatted}" FontSize="12" Foreground="#E5E7EB"/>
                                                    <TextBlock Text="{Binding LocalModifiedText}" FontSize="11" Foreground="#9CA3AF"/>
                                                </StackPanel>

                                                <!-- Server Version info -->
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock Text="SERVER" FontSize="10" Foreground="#6B7280" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding ServerVersion}" FontSize="12" FontWeight="Medium" Foreground="#E5E7EB"/>
                                                    <TextBlock Text="{Binding ServerModifiedText}" FontSize="11" Foreground="#9CA3AF"/>
                                                </StackPanel>

                                                <!-- Sync Status Badge -->
                                                <Border Grid.Column="3" CornerRadius="12" Padding="8,4"
                                                        Background="#111827" BorderBrush="{Binding StatusBrush}" BorderThickness="1"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding StatusBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: DELETED FILES (TRASH) -->
                <TabItem Header="Deleted">
                    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,12,0,0" DataContext="{Binding DeletedFiles}">
                        <!-- Deleted files toolbar -->
                        <Border Grid.Row="0" Background="#1F2937" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#374151" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBox Grid.Column="0" Text="{Binding SearchQuery, Mode=TwoWay}"
                                         Watermark="Search deleted files or folders by path..." Margin="0,0,12,0"/>

                                <Button Grid.Column="1" Content="Refresh"
                                        Command="{Binding RefreshCommand}"
                                        Background="#374151" Foreground="#F3F4F6"
                                        Padding="14,6" Margin="0,0,8,0"/>

                                <Button Grid.Column="2" Content="Empty Trash"
                                        Command="{Binding EmptyTrashCommand}"
                                        IsEnabled="{Binding HasItems}"
                                        Background="#7F1D1D" Foreground="#FCA5A5" FontWeight="SemiBold"
                                        Padding="14,6" Margin="0,0,12,0"/>

                                <TextBlock Grid.Column="3" Text="{Binding SummaryText}"
                                           Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Confirmation Banner for Permanent Delete / Empty Trash -->
                        <Border Grid.Row="1" IsVisible="{Binding IsConfirmVisible}"
                                Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConfirmTitle}" FontWeight="Bold" FontSize="13" Foreground="#FCA5A5"/>
                                    <TextBlock Text="{Binding ConfirmMessage}" FontSize="12" Foreground="#FECACA" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="Yes, delete forever"
                                        Command="{Binding ConfirmYesCommand}"
                                        Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                                        Padding="12,6" Margin="12,0,8,0" VerticalAlignment="Center"/>

                                <Button Grid.Column="2" Content="Cancel"
                                        Command="{Binding ConfirmNoCommand}"
                                        Background="#374151" Foreground="#F3F4F6"
                                        Padding="12,6" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Status message banner -->
                        <Border Grid.Row="2" IsVisible="{Binding HasStatusMessage}"
                                Background="#111827" BorderBrush="{Binding StatusBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                       Foreground="{Binding StatusBrush}" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Deleted Items List -->
                        <Border Grid.Row="3" Background="#1F2937" CornerRadius="8" BorderBrush="#374151" BorderThickness="1">
                            <Panel>
                                <TextBlock Text="Trash is empty — deleted files and folders will appear here."
                                           IsVisible="{Binding IsEmpty}"
                                           Foreground="#9CA3AF" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <ListBox ItemsSource="{Binding Items}" Background="Transparent" IsVisible="{Binding HasItems}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DeletedItemViewModel">
                                            <Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="10,8">
                                                <Grid ColumnDefinitions="Auto,3*,1.5*,1.5*,Auto">
                                                    <!-- Type Icon -->
                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                    <!-- File/Folder name & path -->
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#F9FAFB"/>
                                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Size / Contained items -->
                                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="DETAILS" FontSize="10" Foreground="#6B7280" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding DetailText}" FontSize="12" Foreground="#E5E7EB"/>
                                                    </StackPanel>

                                                    <!-- Deleted At timestamp -->
                                                    <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="DELETED" FontSize="10" Foreground="#6B7280" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding DeletedAtText}" FontSize="12" Foreground="#E5E7EB"/>
                                                    </StackPanel>

                                                    <!-- Restore & Delete Forever actions -->
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="↩ Restore"
                                                                Command="{Binding RestoreCommand}"
                                                                Background="#059669" Foreground="White" FontWeight="SemiBold"
                                                                Padding="12,6"/>
                                                        <Button Content="Delete forever"
                                                                Command="{Binding PurgeCommand}"
                                                                Background="#374151" Foreground="#FCA5A5"
                                                                Padding="10,6"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Panel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 3: ACTIVITIES -->
                <TabItem Header="Activities">
                    <Grid RowDefinitions="Auto,*" Margin="0,12,0,0" DataContext="{Binding Activities}">
                        <!-- Activities Toolbar -->
                        <Border Grid.Row="0" Background="#1F2937" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#374151" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}"
                                         Watermark="Search activities..." Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding SummaryText}"
                                           Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Activities 2-Column List: Activity | When -->
                        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" BorderBrush="#374151" BorderThickness="1">
                            <Panel>
                                <TextBlock Text="No activities yet — file syncs, edits, and app events will appear here."
                                           IsVisible="{Binding IsEmpty}"
                                           Foreground="#9CA3AF" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <ListBox ItemsSource="{Binding FilteredActivities}" Background="Transparent" IsVisible="{Binding HasActivities}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ActivityItemViewModel">
                                            <Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="12,10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <!-- Activity description (Column 1) -->
                                                    <TextBlock Grid.Column="0" Text="{Binding Activity}"
                                                               FontSize="13" FontWeight="Medium" Foreground="#F3F4F6"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                    <!-- When (Column 2) with tooltip showing full timestamp -->
                                                    <TextBlock Grid.Column="1" Text="{Binding WhenText}"
                                                               FontSize="12" Foreground="#9CA3AF" FontWeight="Normal"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Margin="16,0,4,0"
                                                               ToolTip.Tip="{Binding FullTimestampText}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Panel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 4: SERVER ACTIVITY LOGS -->
                <TabItem Header="Server Logs">
                    <Grid RowDefinitions="Auto,*" Margin="0,12,0,0" DataContext="{Binding Logs}">
                        <!-- Logs Toolbar -->
                        <Border Grid.Row="0" Background="#1F2937" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#374151" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                <TextBox Grid.Column="0" Text="{Binding SearchQuery, Mode=TwoWay}"
                                         Watermark="Search logs by path or message..." Margin="0,0,10,0"/>

                                <ComboBox Grid.Column="1" ItemsSource="{Binding ActionFilters}"
                                          SelectedItem="{Binding SelectedActionFilter, Mode=TwoWay}"
                                          Width="120" Margin="0,0,10,0"/>

                                <ComboBox Grid.Column="2" ItemsSource="{Binding ResultFilters}"
                                          SelectedItem="{Binding SelectedResultFilter, Mode=TwoWay}"
                                          Width="120" Margin="0,0,10,0"/>

                                <CheckBox Grid.Column="3" Content="Auto-Refresh"
                                          IsChecked="{Binding AutoRefreshEnabled, Mode=TwoWay}"
                                          Margin="0,0,10,0" VerticalAlignment="Center"/>

                                <Button Grid.Column="4" Content="Refresh"
                                        Command="{Binding RefreshCommand}"
                                        Background="#374151" Foreground="#F3F4F6" Padding="12,6"/>
                            </Grid>
                        </Border>

                        <!-- Logs Data List -->
                        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" BorderBrush="#374151" BorderThickness="1">
                            <ListBox ItemsSource="{Binding Logs}" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="10,7">
                                            <Grid ColumnDefinitions="140,90,90,*,120">
                                                <!-- Timestamp -->
                                                <TextBlock Grid.Column="0" Text="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                           FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>

                                                <!-- Action -->
                                                <Border Grid.Column="1" CornerRadius="6" Background="#374151" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Action}" FontSize="11" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                                </Border>

                                                <!-- Result -->
                                                <Border Grid.Column="2" CornerRadius="6" Background="#111827" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Result}" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                                </Border>

                                                <!-- Path & Message -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0">
                                                    <TextBlock Text="{Binding Path}" FontSize="12" FontWeight="Medium" Foreground="#E5E7EB" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Device -->
                                                <TextBlock Grid.Column="4" Text="{Binding DeviceId}" FontSize="11" Foreground="#6B7280"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 4: SETTINGS -->
                <TabItem Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,12,0,0" Spacing="16" DataContext="{Binding Settings}">
                            <!-- Sync Folder Settings Card -->
                            <Border Background="#1F2937" CornerRadius="10" Padding="20" BorderBrush="#374151" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Local Sync Directory" FontSize="16" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                    <TextBlock Text="{Binding CurrentSyncFolder}" FontSize="13" Foreground="#60A5FA" FontWeight="Medium"/>

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                        <TextBox Grid.Column="0" Text="{Binding NewSyncFolderInput, Mode=TwoWay}"
                                                 Watermark="Enter new absolute folder path to switch directory..."
                                                 Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" Content="Change Folder"
                                                Command="{Binding RequestChangeFolderCommand}"
                                                Background="#2563EB" Foreground="White" Padding="14,7"/>
                                    </Grid>

                                    <!-- Confirmation Warning Card -->
                                    <Border Background="#451A03" BorderBrush="#B45309" BorderThickness="1" CornerRadius="8" Padding="14"
                                            IsVisible="{Binding ShowFolderChangeConfirmation}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="⚠️ Changing Synced Folder" FontWeight="Bold" Foreground="#FDE047"/>
                                            <TextBlock Text="Switching the sync folder will create a new sync tracking state for the target directory. Existing local files in the current folder will remain on disk, but sync will switch to the new path."
                                                       Foreground="#FEF08A" FontSize="12" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                                <Button Content="Confirm &amp; Switch" Command="{Binding ConfirmChangeFolderCommand}"
                                                        Background="#CA8A04" Foreground="Black" FontWeight="Bold" Padding="12,6"/>
                                                <Button Content="Cancel" Command="{Binding CancelChangeFolderCommand}"
                                                        Background="#374151" Foreground="White" Padding="12,6"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Server URL Configuration Card -->
                            <Border Background="#1F2937" CornerRadius="10" Padding="20" BorderBrush="#374151" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Server Connection URL" FontSize="16" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                    <TextBlock Text="Set the FolderSyncEr Web API endpoint (URL and port) to connect to:" FontSize="12" Foreground="#9CA3AF"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBox Grid.Column="0" Text="{Binding ServerUrl, Mode=TwoWay}"
                                                 Watermark="http://localhost:5000" Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" Content="Save URL"
                                                Command="{Binding SaveServerUrlCommand}"
                                                Background="#059669" Foreground="White" FontWeight="SemiBold" Padding="14,7"/>
                                    </Grid>
                                    <CheckBox Content="Allow untrusted/self-signed SSL/TLS certificates (e.g. for internal https:// LAN servers)"
                                              IsChecked="{Binding AllowUntrustedCertificates, Mode=TwoWay}"
                                              Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding ServerUrlStatusMessage}" Foreground="#10B981" FontSize="12"
                                               IsVisible="{Binding HasServerUrlStatusMessage}"/>
                                </StackPanel>
                            </Border>

                            <!-- Conflict Policy & Behavior Card -->
                            <Border Background="#1F2937" CornerRadius="10" Padding="20" BorderBrush="#374151" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Conflict Resolution Policy" FontSize="16" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                    <TextBlock Text="Choose how conflicting edits between devices are handled:" FontSize="12" Foreground="#9CA3AF"/>

                                    <ComboBox ItemsSource="{Binding AvailablePolicies}"
                                              SelectedItem="{Binding SelectedConflictPolicy, Mode=TwoWay}"
                                              Width="240"/>

                                    <TextBlock Text="• KeepBoth: Clones the local file to 'name (conflict device timestamp).ext' and keeps server version as main file."
                                               FontSize="11" Foreground="#9CA3AF"/>
                                    <TextBlock Text="• NewestWins: Automatically compares UTC modification dates."
                                               FontSize="11" Foreground="#9CA3AF"/>
                                    <TextBlock Text="• Prompt: Interactively asks you to choose Keep Local, Keep Server, or Keep Both."
                                               FontSize="11" Foreground="#9CA3AF"/>
                                </StackPanel>
                            </Border>

                            <!-- Background Sync & System Tray Card -->
                            <Border Background="#1F2937" CornerRadius="10" Padding="20" BorderBrush="#374151" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="System Tray &amp; Background Sync" FontSize="16" FontWeight="SemiBold" Foreground="#F3F4F6"/>

                                    <CheckBox Content="Close to System Tray (Keep running in background when window is closed)"
                                              IsChecked="{Binding CloseToTray, Mode=TwoWay}"/>

                                    <CheckBox Content="Start Minimized to System Tray (Launch hidden in the tray on startup)"
                                              IsChecked="{Binding StartMinimized, Mode=TwoWay}"/>

                                    <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                                        <TextBlock Grid.Column="0" Text="Periodic Scan Interval (seconds):" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <NumericUpDown Grid.Column="1" Value="{Binding SyncIntervalSeconds, Mode=TwoWay}" Minimum="10" Maximum="3600" Width="140" HorizontalAlignment="Left"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="Update Cooldown (seconds):" Foreground="#9CA3AF"
                                                       ToolTip.Tip="Quiet period before syncing changes. Resets on each new file write to bundle rapid edits together and prevent server version churn."/>
                                        </StackPanel>
                                        <NumericUpDown Grid.Column="1" Value="{Binding UpdateCooldownSeconds, Mode=TwoWay}" Minimum="1" Maximum="300" Width="140" HorizontalAlignment="Left"
                                                       ToolTip.Tip="Quiet period before syncing changes. Resets on each new file write to bundle rapid edits together and prevent server version churn."/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="Max Wait (seconds):" Foreground="#9CA3AF"
                                                       ToolTip.Tip="Ceiling timeout for continuous writes. If an application never stops writing, sync triggers anyway after this duration (default 300s / 5 minutes)."/>
                                        </StackPanel>
                                        <NumericUpDown Grid.Column="1" Value="{Binding MaxWaitSeconds, Mode=TwoWay}" Minimum="10" Maximum="3600" Width="140" HorizontalAlignment="Left"
                                                       ToolTip.Tip="Ceiling timeout for continuous writes. If an application never stops writing, sync triggers anyway after this duration (default 300s / 5 minutes)."/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Admin Inspection & Archive Export Card -->
                            <Border Background="#1F2937" CornerRadius="10" Padding="20" BorderBrush="#374151" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Inspection &amp; Server Archive" FontSize="16" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                    <TextBlock Text="Download all latest server files reconstructed into a single ZIP archive for offline inspection or backup."
                                               FontSize="12" Foreground="#9CA3AF"/>
                                    <Button Content="Download Server Folder (ZIP)"
                                            Command="{Binding DownloadArchiveCommand}"
                                            IsEnabled="{Binding !IsDownloadingArchive}"
                                            Background="#059669" Foreground="White" FontWeight="SemiBold"
                                            Padding="14,8" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- App Configuration & Log Files Card -->
                            <Border Background="#1F2937" CornerRadius="10" Padding="20" BorderBrush="#374151" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="App Configuration &amp; Log Files" FontSize="16" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                    <TextBlock Text="All client application preferences and settings are stored locally in:"
                                               FontSize="12" Foreground="#9CA3AF"/>

                                    <!-- Clickable Link to Settings File -->
                                    <Button Command="{Binding OpenSettingsFileCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Cursor="Hand"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="📄" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SettingsFilePath}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="#60A5FA"
                                                       TextDecorations="Underline"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="{Binding OpenSettingsStatus}"
                                               Foreground="#10B981"
                                               FontSize="11"
                                               IsVisible="{Binding HasOpenSettingsStatus}"/>

                                    <TextBlock Text="Today's application log file (retained for 30 days):"
                                               FontSize="12" Foreground="#9CA3AF" Margin="0,6,0,0"/>

                                    <!-- Clickable Link to Current Daily Log File -->
                                    <Button Command="{Binding OpenLogFileCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Cursor="Hand"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentLogFilePath}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="#60A5FA"
                                                       TextDecorations="Underline"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="{Binding OpenLogStatus}"
                                               Foreground="#10B981"
                                               FontSize="11"
                                               IsVisible="{Binding HasOpenLogStatus}"/>

                                    <TextBlock Text="Secure Credential &amp; Token Storage:"
                                               FontSize="12" Foreground="#9CA3AF" Margin="0,6,0,0"/>

                                    <Border CornerRadius="8" Padding="10,6" Background="#111827" BorderBrush="#374151" BorderThickness="1" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#10B981"/>
                                            <TextBlock Text="{Binding SecretStoreDescription}" FontSize="12" Foreground="#E5E7EB" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Authentication tokens, device credentials, and server connection secrets are encrypted and stored using your operating system's native keyring service rather than in plaintext configuration files."
                                               FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Application Build & Version Info Card -->
                            <Border Background="#1F2937" CornerRadius="10" Padding="20" BorderBrush="#374151" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Application Information" FontSize="16" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Client Version:" Foreground="#9CA3AF" FontSize="12" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="12"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Compiled DateTime:" Foreground="#9CA3AF" FontSize="12"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppCompileDateTime}" Foreground="#E5E7EB" FontWeight="Medium" FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 5: ACCOUNTS -->
                <TabItem Header="Accounts">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,12,0,0" Spacing="16">
                            <!-- Connection Status -->
                            <Border Background="#1F2937" CornerRadius="10" Padding="20" BorderBrush="#374151" BorderThickness="1"
                                    DataContext="{Binding Connection}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Server Connection Check" FontSize="16" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                    <TextBlock Text="Test connectivity to the Web API server (configure persistent URL on the Settings tab):" FontSize="12" Foreground="#9CA3AF"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBox Grid.Column="0" Text="{Binding ServerUrl, Mode=TwoWay}" Watermark="http://localhost:5000" Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" Content="Check Connection" Command="{Binding CheckConnectionCommand}"
                                                Background="#2563EB" Foreground="White" FontWeight="SemiBold" Padding="14,7"/>
                                    </Grid>
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="12"
                                               IsVisible="{Binding HasErrorMessage}"/>
                                    <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,8,0,0">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="STATUS" FontSize="10" Foreground="#9CA3AF" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="SERVER VERSION" FontSize="10" Foreground="#9CA3AF" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding ServerVersionText}" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="LATENCY" FontSize="10" Foreground="#9CA3AF" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding LatencyText}" FontSize="14" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="SERVER CLOCK (UTC)" FontSize="10" Foreground="#9CA3AF" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding ServerTimeText}" FontSize="14" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="SERVER COMPILED (UTC)" FontSize="10" Foreground="#9CA3AF" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding ServerCompiledText}" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Account / Login -->
                            <Border Background="#1F2937" CornerRadius="10" Padding="20" BorderBrush="#374151" BorderThickness="1"
                                    DataContext="{Binding Login}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Authentication &amp; Session" FontSize="16" FontWeight="SemiBold" Foreground="#F3F4F6"/>

                                    <StackPanel Spacing="12" IsVisible="{Binding IsLoggedIn}">
                                        <Border Background="#111827" CornerRadius="8" Padding="14">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Signed In As:" FontSize="11" Foreground="#9CA3AF"/>
                                                    <TextBlock Text="{Binding LoggedInUserText}" FontSize="16" FontWeight="Bold" Foreground="#10B981"/>
                                                    <TextBlock Text="{Binding CurrentDeviceDisplay, StringFormat='Device: {0}'}" FontSize="12" Foreground="#9CA3AF"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Sign Out" Command="{Binding LogoutCommand}"
                                                        Background="#DC2626" Foreground="White" Padding="14,6" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Logged-In Devices List -->
                                        <Border Background="#111827" CornerRadius="8" Padding="14" BorderBrush="#374151" BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="Logged-In Devices" FontSize="14" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                                        <TextBlock Text="All active devices where this user account is currently signed in:" FontSize="11" Foreground="#9CA3AF"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="↻ Refresh" Command="{Binding RefreshDevicesCommand}"
                                                            IsEnabled="{Binding !IsLoadingDevices}"
                                                            Background="#374151" Foreground="#E5E7EB" FontSize="12" Padding="10,5" VerticalAlignment="Center"/>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding LoggedInDevices}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1F2937" CornerRadius="6" Padding="12,10" Margin="0,4,0,0"
                                                                    BorderBrush="#374151" BorderThickness="1">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                            <TextBlock Text="💻" FontSize="14" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#F3F4F6" VerticalAlignment="Center"/>
                                                                            <Border Background="#065F46" CornerRadius="4" Padding="6,2"
                                                                                    IsVisible="{Binding IsCurrentDevice}" VerticalAlignment="Center">
                                                                                <TextBlock Text="This Device" FontSize="10" FontWeight="Bold" Foreground="#6EE7B7"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                                                            <TextBlock Text="{Binding DisplayIdText}" FontSize="11" Foreground="#9CA3AF"/>
                                                                            <TextBlock Text="{Binding LastSeenText}" FontSize="11" Foreground="#6B7280"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Content="Sign Out Device"
                                                                            Command="{Binding RevokeCommand}"
                                                                            IsVisible="{Binding CanRevoke}"
                                                                            Background="#7F1D1D" Foreground="#FCA5A5"
                                                                            FontSize="11" Padding="10,5" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Login form -->
                                    <StackPanel Spacing="10" IsVisible="{Binding !IsLoggedIn}">
                                        <TextBox Text="{Binding Username, Mode=TwoWay}" Watermark="Username"/>
                                        <TextBox Text="{Binding Password, Mode=TwoWay}" PasswordChar="•" Watermark="Password"/>
                                        <TextBox Text="{Binding DeviceName, Mode=TwoWay}" Watermark="Device Name (e.g. My-Laptop)"/>
                                        <Button Content="Sign In" Command="{Binding LoginCommand}"
                                                Background="#2563EB" Foreground="White" FontWeight="Bold"
                                                Padding="16,8" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="12"
                                                   IsVisible="{Binding HasErrorMessage}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Interactive Conflict Dialog Modal Overlay -->
        <Border Background="#B2000000" IsVisible="{Binding ConflictPrompt.IsVisible}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#1F2937" BorderBrush="#F59E0B" BorderThickness="2"
                    CornerRadius="14" Padding="24" Width="580"
                    DataContext="{Binding ConflictPrompt}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="22"/>
                        <TextBlock Text="File Conflict Detected" FontSize="20" FontWeight="Bold" Foreground="#FDE047"/>
                    </StackPanel>

                    <TextBlock Text="{Binding FilePath}" FontWeight="Bold" FontSize="15" Foreground="#60A5FA"/>
                    <TextBlock Text="{Binding DeviceInfoText}" FontSize="12" Foreground="#9CA3AF"/>

                    <!-- Local vs Server Comparison Cards -->
                    <Border Background="#111827" CornerRadius="8" Padding="12" BorderBrush="#374151" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="LOCAL FILE (Current on this device):" FontWeight="Bold" FontSize="11" Foreground="#3B82F6"/>
                            <TextBlock Text="{Binding LocalInfoText}" FontSize="12" Foreground="#E5E7EB"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#111827" CornerRadius="8" Padding="12" BorderBrush="#374151" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="SERVER FILE (Remote version):" FontWeight="Bold" FontSize="11" Foreground="#8B5CF6"/>
                            <TextBlock Text="{Binding RemoteInfoText}" FontSize="12" Foreground="#E5E7EB"/>
                        </StackPanel>
                    </Border>

                    <!-- Conflict Choices -->
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock Text="How would you like to resolve this conflict?" FontSize="12" FontWeight="SemiBold" Foreground="#D1D5DB"/>
                        <Grid ColumnDefinitions="*,*,*">
                            <Button Grid.Column="0" Content="Keep Local"
                                    Command="{Binding KeepLocalCommand}"
                                    Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                                    Padding="10,8" Margin="0,0,6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                            <Button Grid.Column="1" Content="Keep Server"
                                    Command="{Binding KeepServerCommand}"
                                    Background="#7C3AED" Foreground="White" FontWeight="SemiBold"
                                    Padding="10,8" Margin="3,0,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                            <Button Grid.Column="2" Content="Keep Both"
                                    Command="{Binding KeepBothCommand}"
                                    Background="#059669" Foreground="White" FontWeight="SemiBold"
                                    Padding="10,8" Margin="6,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Keep Both creates a conflict copy: 'name (conflict device timestamp).ext'"
                                   FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
