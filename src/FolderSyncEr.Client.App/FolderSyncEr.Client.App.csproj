<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <VersionMajor>1</VersionMajor>
    <VersionMinor>4</VersionMinor>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <BuildVersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\build.client.version'))</BuildVersionFile>
  </PropertyGroup>

  <Target Name="AutoIncrementClientBuildVersion"
          BeforeTargets="BeforeCompile;CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ReadLinesFromFile File="$(BuildVersionFile)" Condition="Exists('$(BuildVersionFile)')">
      <Output TaskParameter="Lines" ItemName="_CurrentBuildLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_RawBuildNumber>@(_CurrentBuildLines)</_RawBuildNumber>
      <_RawBuildNumber Condition="'$(_RawBuildNumber)' == ''">0</_RawBuildNumber>
      <BuildNumber Condition="'$(SkipAutoIncrementVersion)' == 'true'">$(_RawBuildNumber)</BuildNumber>
      <BuildNumber Condition="'$(SkipAutoIncrementVersion)' != 'true'">$([MSBuild]::Add($(_RawBuildNumber), 1))</BuildNumber>
      <Version>$(VersionMajor).$(VersionMinor).$(BuildNumber)</Version>
      <AssemblyVersion>$(VersionMajor).$(VersionMinor).$(BuildNumber).0</AssemblyVersion>
      <FileVersion>$(VersionMajor).$(VersionMinor).$(BuildNumber).0</FileVersion>
      <InformationalVersion>$(VersionMajor).$(VersionMinor).$(BuildNumber)</InformationalVersion>
      <_GeneratedVersionFile>$(IntermediateOutputPath)AutoGeneratedBuildVersion.g.cs</_GeneratedVersionFile>
      <_GeneratedVersionContent>[assembly: System.Reflection.AssemblyVersion("$(AssemblyVersion)")]
[assembly: System.Reflection.AssemblyFileVersion("$(FileVersion)")]
[assembly: System.Reflection.AssemblyInformationalVersion("$(InformationalVersion)")]</_GeneratedVersionContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildVersionFile)" Lines="$(BuildNumber)" Overwrite="true" Condition="'$(SkipAutoIncrementVersion)' != 'true'" />
    <WriteLinesToFile File="$(_GeneratedVersionFile)" Lines="$(_GeneratedVersionContent)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(_GeneratedVersionFile)" />
      <FileWrites Include="$(_GeneratedVersionFile)" />
    </ItemGroup>
    <Message Text="FolderSyncEr.Client.App build version: v$(Version)" Importance="High" />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FolderSyncEr.Contracts\FolderSyncEr.Contracts.csproj" />
    <ProjectReference Include="..\FolderSyncEr.Client.Platform\FolderSyncEr.Client.Platform.csproj" />
    <ProjectReference Include="..\FolderSyncEr.Client.Api\FolderSyncEr.Client.Api.csproj" />
    <ProjectReference Include="..\FolderSyncEr.Client.Sync\FolderSyncEr.Client.Sync.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
  </PropertyGroup>

</Project>
