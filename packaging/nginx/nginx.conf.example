# /etc/nginx/sites-available/foldersyncer.conf
# Production reverse proxy for FolderSyncEr Server with TLS termination

server {
    listen 80;
    server_name foldersync.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name foldersync.example.com;

    ssl_certificate /etc/ssl/certs/foldersync.crt;
    ssl_certificate_key /etc/ssl/private/foldersync.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Allow up to 10GB file uploads
    client_max_body_size 10G;
    client_body_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection keep-alive;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}

